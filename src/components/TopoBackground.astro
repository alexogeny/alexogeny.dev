---
/**
 * Topographical map background component
 * Generates random contour lines on a black background
 */
---

<div id="topo-bg" aria-hidden="true">
  <canvas id="topo-canvas"></canvas>
</div>

<style is:global>
  #topo-bg {
    position: fixed !important;
    inset: 0 !important;
    z-index: -100 !important;
    background: #000 !important;
    pointer-events: none !important;
  }

  #topo-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script is:inline>
(function() {
  var ready = false;

  function init() {
    if (ready) return;

    var canvas = document.getElementById('topo-canvas');
    if (!canvas) {
      requestAnimationFrame(init);
      return;
    }

    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    ready = true;
    var seed = Date.now() % 10000;
    var perm = [];

    // Simple seeded RNG
    function rng(s) {
      return function() {
        s = (s * 1103515245 + 12345) & 0x7fffffff;
        return s / 0x7fffffff;
      };
    }

    function initPerm() {
      var p = [], r = rng(seed), i, n, k, tmp;
      for (i = 0; i < 256; i++) p[i] = i;
      for (n = 255; n > 0; n--) {
        k = Math.floor(r() * (n + 1));
        tmp = p[n]; p[n] = p[k]; p[k] = tmp;
      }
      perm = p.concat(p);
    }

    function fade(t) { return t * t * t * (t * (t * 6 - 15) + 10); }
    function lerp(a, b, t) { return a + t * (b - a); }

    function grad(h, x, y) {
      switch (h & 3) {
        case 0: return x + y;
        case 1: return -x + y;
        case 2: return x - y;
        case 3: return -x - y;
      }
      return 0;
    }

    function noise(x, y) {
      var xi = Math.floor(x) & 255;
      var yi = Math.floor(y) & 255;
      var xf = x - Math.floor(x);
      var yf = y - Math.floor(y);
      var u = fade(xf);
      var v = fade(yf);
      var aa = perm[perm[xi] + yi];
      var ab = perm[perm[xi] + yi + 1];
      var ba = perm[perm[xi + 1] + yi];
      var bb = perm[perm[xi + 1] + yi + 1];
      return lerp(
        lerp(grad(aa, xf, yf), grad(ba, xf - 1, yf), u),
        lerp(grad(ab, xf, yf - 1), grad(bb, xf - 1, yf - 1), u),
        v
      );
    }

    function fbm(x, y) {
      var val = 0, amp = 1, freq = 1, i;
      for (i = 0; i < 4; i++) {
        val += amp * noise(x * freq, y * freq);
        amp *= 0.5;
        freq *= 2;
      }
      return val;
    }

    function draw() {
      var w = window.innerWidth;
      var h = window.innerHeight;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Black background
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, w, h);

      var scale = 0.005;
      var levels = 20;
      var step = 5;
      var cols = Math.ceil(w / step) + 1;
      var rows = Math.ceil(h / step) + 1;

      // Build height map
      var hmap = [];
      for (var j = 0; j < rows; j++) {
        hmap[j] = [];
        for (var i = 0; i < cols; i++) {
          hmap[j][i] = fbm(i * step * scale, j * step * scale);
        }
      }

      // Marching squares for contours
      ctx.strokeStyle = '#383838';
      ctx.lineWidth = 1;

      for (var lv = 0; lv < levels; lv++) {
        var t = -0.8 + (lv / levels) * 1.6;
        ctx.beginPath();

        for (var y = 0; y < rows - 1; y++) {
          for (var x = 0; x < cols - 1; x++) {
            var nw = hmap[y][x] > t ? 1 : 0;
            var ne = hmap[y][x + 1] > t ? 1 : 0;
            var se = hmap[y + 1][x + 1] > t ? 1 : 0;
            var sw = hmap[y + 1][x] > t ? 1 : 0;
            var state = nw * 8 + ne * 4 + se * 2 + sw;

            if (state === 0 || state === 15) continue;

            var px = x * step;
            var py = y * step;

            // Interpolation helper
            function mix(a, b) {
              var d = b - a;
              if (Math.abs(d) < 0.001) return 0.5;
              return (t - a) / d;
            }

            var n = mix(hmap[y][x], hmap[y][x + 1]) * step;
            var e = mix(hmap[y][x + 1], hmap[y + 1][x + 1]) * step;
            var s = mix(hmap[y + 1][x], hmap[y + 1][x + 1]) * step;
            var we = mix(hmap[y][x], hmap[y + 1][x]) * step;

            // Draw segments based on marching squares lookup
            switch (state) {
              case 1: case 14:
                ctx.moveTo(px, py + we); ctx.lineTo(px + s, py + step); break;
              case 2: case 13:
                ctx.moveTo(px + s, py + step); ctx.lineTo(px + step, py + e); break;
              case 3: case 12:
                ctx.moveTo(px, py + we); ctx.lineTo(px + step, py + e); break;
              case 4: case 11:
                ctx.moveTo(px + n, py); ctx.lineTo(px + step, py + e); break;
              case 5:
                ctx.moveTo(px + n, py); ctx.lineTo(px, py + we);
                ctx.moveTo(px + s, py + step); ctx.lineTo(px + step, py + e); break;
              case 6: case 9:
                ctx.moveTo(px + n, py); ctx.lineTo(px + s, py + step); break;
              case 7: case 8:
                ctx.moveTo(px + n, py); ctx.lineTo(px, py + we); break;
              case 10:
                ctx.moveTo(px + n, py); ctx.lineTo(px + step, py + e);
                ctx.moveTo(px, py + we); ctx.lineTo(px + s, py + step); break;
            }
          }
        }
        ctx.stroke();
      }
    }

    initPerm();
    draw();

    var timeout;
    window.addEventListener('resize', function() {
      clearTimeout(timeout);
      timeout = setTimeout(draw, 150);
    });
  }

  // Try to initialize
  if (document.readyState === 'complete') {
    init();
  } else {
    window.addEventListener('load', init);
  }

  // Also try after a short delay as fallback
  setTimeout(init, 100);
})();
</script>
