---
/**
 * Topographical map background component
 * Generates contour lines at build time as SVG - no client JS needed
 */

// Seeded random number generator
function seededRandom(seed: number) {
  return function() {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed / 0x7fffffff;
  };
}

// Perlin noise implementation
function createNoise(seed: number) {
  const random = seededRandom(seed);
  const perm: number[] = [];

  // Initialize permutation table
  for (let i = 0; i < 256; i++) perm[i] = i;
  for (let i = 255; i > 0; i--) {
    const j = Math.floor(random() * (i + 1));
    [perm[i], perm[j]] = [perm[j], perm[i]];
  }
  for (let i = 0; i < 256; i++) perm[256 + i] = perm[i];

  function fade(t: number) { return t * t * t * (t * (t * 6 - 15) + 10); }
  function lerp(a: number, b: number, t: number) { return a + t * (b - a); }
  function grad(hash: number, x: number, y: number) {
    switch (hash & 3) {
      case 0: return x + y;
      case 1: return -x + y;
      case 2: return x - y;
      default: return -x - y;
    }
  }

  return function noise(x: number, y: number) {
    const xi = Math.floor(x) & 255;
    const yi = Math.floor(y) & 255;
    const xf = x - Math.floor(x);
    const yf = y - Math.floor(y);
    const u = fade(xf);
    const v = fade(yf);
    const aa = perm[perm[xi] + yi];
    const ab = perm[perm[xi] + yi + 1];
    const ba = perm[perm[xi + 1] + yi];
    const bb = perm[perm[xi + 1] + yi + 1];
    return lerp(
      lerp(grad(aa, xf, yf), grad(ba, xf - 1, yf), u),
      lerp(grad(ab, xf, yf - 1), grad(bb, xf - 1, yf - 1), u),
      v
    );
  };
}

function fbm(noise: (x: number, y: number) => number, x: number, y: number) {
  let val = 0, amp = 1, freq = 1;
  for (let i = 0; i < 4; i++) {
    val += amp * noise(x * freq, y * freq);
    amp *= 0.5;
    freq *= 2;
  }
  return val;
}

// Generate SVG paths for contours
const seed = Math.floor(Math.random() * 100000);
const noise = createNoise(seed);
const width = 1920;
const height = 1080;
const scale = 0.006;
const levels = 18;
const step = 8;
const cols = Math.ceil(width / step) + 1;
const rows = Math.ceil(height / step) + 1;

// Build height map
const hmap: number[][] = [];
for (let j = 0; j < rows; j++) {
  hmap[j] = [];
  for (let i = 0; i < cols; i++) {
    hmap[j][i] = fbm(noise, i * step * scale, j * step * scale);
  }
}

// Generate paths using marching squares
const paths: string[] = [];

for (let lv = 0; lv < levels; lv++) {
  const threshold = -0.7 + (lv / levels) * 1.4;
  let d = '';

  for (let y = 0; y < rows - 1; y++) {
    for (let x = 0; x < cols - 1; x++) {
      const nw = hmap[y][x] > threshold ? 1 : 0;
      const ne = hmap[y][x + 1] > threshold ? 1 : 0;
      const se = hmap[y + 1][x + 1] > threshold ? 1 : 0;
      const sw = hmap[y + 1][x] > threshold ? 1 : 0;
      const state = nw * 8 + ne * 4 + se * 2 + sw;

      if (state === 0 || state === 15) continue;

      const px = x * step;
      const py = y * step;

      function mix(a: number, b: number) {
        const diff = b - a;
        if (Math.abs(diff) < 0.001) return 0.5;
        return (threshold - a) / diff;
      }

      const n = px + mix(hmap[y][x], hmap[y][x + 1]) * step;
      const e = py + mix(hmap[y][x + 1], hmap[y + 1][x + 1]) * step;
      const s = px + mix(hmap[y + 1][x], hmap[y + 1][x + 1]) * step;
      const w = py + mix(hmap[y][x], hmap[y + 1][x]) * step;

      const segments: [number, number, number, number][] = [];

      switch (state) {
        case 1: case 14: segments.push([px, w, s, py + step]); break;
        case 2: case 13: segments.push([s, py + step, px + step, e]); break;
        case 3: case 12: segments.push([px, w, px + step, e]); break;
        case 4: case 11: segments.push([n, py, px + step, e]); break;
        case 5:
          segments.push([n, py, px, w]);
          segments.push([s, py + step, px + step, e]);
          break;
        case 6: case 9: segments.push([n, py, s, py + step]); break;
        case 7: case 8: segments.push([n, py, px, w]); break;
        case 10:
          segments.push([n, py, px + step, e]);
          segments.push([px, w, s, py + step]);
          break;
      }

      for (const seg of segments) {
        d += `M${seg[0].toFixed(1)},${seg[1].toFixed(1)}L${seg[2].toFixed(1)},${seg[3].toFixed(1)}`;
      }
    }
  }

  if (d) paths.push(d);
}
---

<div id="topo-bg" aria-hidden="true">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="xMidYMid slice"
  >
    {paths.map((d) => (
      <path d={d} fill="none" stroke="#333" stroke-width="1" />
    ))}
  </svg>
</div>

<style is:global>
  #topo-bg {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -1;
    background: #000;
    overflow: hidden;
  }

  #topo-bg svg {
    width: 100%;
    height: 100%;
    opacity: 0.9;
  }
</style>
