---
/**
 * Topographical map background component
 * Generates random contour lines on a black background with dark gray lines
 */
---

<canvas id="topo-canvas" class="fixed inset-0 -z-10 h-full w-full"></canvas>

<script>
  class TopoBackground {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private width: number = 0;
    private height: number = 0;
    private seed: number;
    private permutation: number[] = [];

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Could not get canvas context');
      this.ctx = ctx;
      this.seed = Math.random() * 10000;
      this.initPermutation();
      this.resize();
      this.draw();

      window.addEventListener('resize', () => {
        this.resize();
        this.draw();
      });
    }

    private initPermutation(): void {
      // Initialize permutation table for noise
      const p = [];
      for (let i = 0; i < 256; i++) p[i] = i;

      // Shuffle using seed
      let n = 256;
      let rng = this.mulberry32(this.seed);
      while (n > 1) {
        const k = Math.floor(rng() * n);
        n--;
        [p[n], p[k]] = [p[k], p[n]];
      }

      // Duplicate for overflow
      this.permutation = [...p, ...p];
    }

    private mulberry32(seed: number): () => number {
      return () => {
        let t = seed += 0x6D2B79F5;
        t = Math.imul(t ^ t >>> 15, t | 1);
        t ^= t + Math.imul(t ^ t >>> 7, t | 61);
        return ((t ^ t >>> 14) >>> 0) / 4294967296;
      };
    }

    private fade(t: number): number {
      return t * t * t * (t * (t * 6 - 15) + 10);
    }

    private lerp(a: number, b: number, t: number): number {
      return a + t * (b - a);
    }

    private grad(hash: number, x: number, y: number): number {
      const h = hash & 7;
      const u = h < 4 ? x : y;
      const v = h < 4 ? y : x;
      return ((h & 1) ? -u : u) + ((h & 2) ? -2 * v : 2 * v);
    }

    private noise(x: number, y: number): number {
      const X = Math.floor(x) & 255;
      const Y = Math.floor(y) & 255;

      x -= Math.floor(x);
      y -= Math.floor(y);

      const u = this.fade(x);
      const v = this.fade(y);

      const p = this.permutation;
      const A = p[X] + Y;
      const B = p[X + 1] + Y;

      return this.lerp(
        this.lerp(this.grad(p[A], x, y), this.grad(p[B], x - 1, y), u),
        this.lerp(this.grad(p[A + 1], x, y - 1), this.grad(p[B + 1], x - 1, y - 1), u),
        v
      );
    }

    private fbm(x: number, y: number, octaves: number = 4): number {
      let value = 0;
      let amplitude = 1;
      let frequency = 1;
      let maxValue = 0;

      for (let i = 0; i < octaves; i++) {
        value += amplitude * this.noise(x * frequency, y * frequency);
        maxValue += amplitude;
        amplitude *= 0.5;
        frequency *= 2;
      }

      return value / maxValue;
    }

    private resize(): void {
      const dpr = window.devicePixelRatio || 1;
      this.width = window.innerWidth;
      this.height = window.innerHeight;
      this.canvas.width = this.width * dpr;
      this.canvas.height = this.height * dpr;
      this.canvas.style.width = `${this.width}px`;
      this.canvas.style.height = `${this.height}px`;
      this.ctx.scale(dpr, dpr);
    }

    private draw(): void {
      // Clear with black background
      this.ctx.fillStyle = '#000000';
      this.ctx.fillRect(0, 0, this.width, this.height);

      // Generate height map
      const scale = 0.003;
      const numContours = 20;
      const resolution = 4; // Sample every N pixels for performance

      // Create height data
      const cols = Math.ceil(this.width / resolution) + 1;
      const rows = Math.ceil(this.height / resolution) + 1;
      const heights: number[][] = [];

      for (let y = 0; y < rows; y++) {
        heights[y] = [];
        for (let x = 0; x < cols; x++) {
          const px = x * resolution;
          const py = y * resolution;
          heights[y][x] = this.fbm(px * scale, py * scale, 5);
        }
      }

      // Draw contour lines using marching squares
      this.ctx.strokeStyle = '#1a1a1a';
      this.ctx.lineWidth = 1;

      for (let level = 0; level < numContours; level++) {
        const threshold = (level / numContours) * 2 - 1;
        this.drawContourLevel(heights, threshold, resolution, cols, rows);
      }
    }

    private drawContourLevel(
      heights: number[][],
      threshold: number,
      resolution: number,
      cols: number,
      rows: number
    ): void {
      this.ctx.beginPath();

      for (let y = 0; y < rows - 1; y++) {
        for (let x = 0; x < cols - 1; x++) {
          const tl = heights[y][x];
          const tr = heights[y][x + 1];
          const br = heights[y + 1][x + 1];
          const bl = heights[y + 1][x];

          // Calculate cell case (marching squares)
          let caseIndex = 0;
          if (tl > threshold) caseIndex |= 1;
          if (tr > threshold) caseIndex |= 2;
          if (br > threshold) caseIndex |= 4;
          if (bl > threshold) caseIndex |= 8;

          // Skip empty cases
          if (caseIndex === 0 || caseIndex === 15) continue;

          const px = x * resolution;
          const py = y * resolution;

          // Interpolate edge crossings
          const top = this.interpolate(tl, tr, threshold);
          const right = this.interpolate(tr, br, threshold);
          const bottom = this.interpolate(bl, br, threshold);
          const left = this.interpolate(tl, bl, threshold);

          // Draw line segments based on case
          const points: [number, number][] = [];

          switch (caseIndex) {
            case 1: case 14:
              points.push([px + top * resolution, py]);
              points.push([px, py + left * resolution]);
              break;
            case 2: case 13:
              points.push([px + top * resolution, py]);
              points.push([px + resolution, py + right * resolution]);
              break;
            case 3: case 12:
              points.push([px, py + left * resolution]);
              points.push([px + resolution, py + right * resolution]);
              break;
            case 4: case 11:
              points.push([px + resolution, py + right * resolution]);
              points.push([px + bottom * resolution, py + resolution]);
              break;
            case 5:
              points.push([px + top * resolution, py]);
              points.push([px + resolution, py + right * resolution]);
              this.ctx.moveTo(points[0][0], points[0][1]);
              this.ctx.lineTo(points[1][0], points[1][1]);
              points.length = 0;
              points.push([px, py + left * resolution]);
              points.push([px + bottom * resolution, py + resolution]);
              break;
            case 6: case 9:
              points.push([px + top * resolution, py]);
              points.push([px + bottom * resolution, py + resolution]);
              break;
            case 7: case 8:
              points.push([px, py + left * resolution]);
              points.push([px + bottom * resolution, py + resolution]);
              break;
            case 10:
              points.push([px + top * resolution, py]);
              points.push([px, py + left * resolution]);
              this.ctx.moveTo(points[0][0], points[0][1]);
              this.ctx.lineTo(points[1][0], points[1][1]);
              points.length = 0;
              points.push([px + resolution, py + right * resolution]);
              points.push([px + bottom * resolution, py + resolution]);
              break;
          }

          if (points.length === 2) {
            this.ctx.moveTo(points[0][0], points[0][1]);
            this.ctx.lineTo(points[1][0], points[1][1]);
          }
        }
      }

      this.ctx.stroke();
    }

    private interpolate(v1: number, v2: number, threshold: number): number {
      if (Math.abs(v2 - v1) < 0.0001) return 0.5;
      return (threshold - v1) / (v2 - v1);
    }
  }

  // Initialize on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('topo-canvas') as HTMLCanvasElement;
    if (canvas) {
      new TopoBackground(canvas);
    }
  });

  // Also try to init immediately in case DOM is already loaded
  const canvas = document.getElementById('topo-canvas') as HTMLCanvasElement;
  if (canvas) {
    new TopoBackground(canvas);
  }
</script>
