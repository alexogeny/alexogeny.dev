---
import { getPermalink } from '~/utils/permalinks';

import { APP_BLOG } from '~/utils/config';
import type { Post } from '~/types';

export interface Props {
  tags: Post['tags'];
  class?: string;
  title?: string | undefined;
  isCategory?: boolean;
}

const {
  tags,
  class: className,
  title = undefined,
  isCategory = false,
} = Astro.props;

const baseClass = 'flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-300';
const listClass = className ? `${baseClass} ${className}` : baseClass;
---

{
  tags &&
    Array.isArray(tags) && (
      <div class="space-y-2">
        {title !== undefined && (
          <span class="block text-xs font-semibold uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">{title}</span>
        )}
        <ul class={listClass}>
          {tags.map((tag) => (
            <li class="inline-flex items-center rounded-full border border-slate-200 bg-white/70 px-3 py-1 text-xs font-medium lowercase text-slate-600 transition hover:border-slate-300 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300 dark:hover:border-slate-500">
              {!APP_BLOG?.tag?.isEnabled ? (
                tag
              ) : (
                <a
                  href={getPermalink(tag, isCategory ? 'category' : 'tag')}
                  class="transition hover:text-sky-600 dark:hover:text-sky-400"
                >
                  {tag}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    )
}
