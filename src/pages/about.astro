---
import Layout from "~/layouts/PageLayout.astro";

const metadata = {
  title: "About Alex Mack",
  description:
    "An orientation to the fictional field notes, maintenance rituals, and gentle engineering myths that power alexogeny.dev.",
};

const orientation = [
  {
    label: "Primary work",
    value:
      "Designing telemetry tools for electric mobility teams — translating field notes into interfaces crews can trust, even when the story bends toward fiction.",
  },
  {
    label: "Approach",
    value:
      "Slow the room down, listen longer than feels efficient, and leave systems kinder than I found them — in your timeline or mine.",
  },
  {
    label: "Collaborators",
    value: "Operators, support leads, infra folks, and anyone who tends the lights after hours, real or imagined.",
  },
  {
    label: "Otherwise",
    value:
      "Restoring family archives, teaching friends checksum rituals, and getting lost in long-form jazz chords that sound like uptime graphs.",
  },
];

const timeline = [
  {
    period: "Fleet telemetry dream",
    title: "Electric mobility operations",
    description:
      "Guiding a small cross-functional crew building quiet telemetry for fleet charging networks. Lots of latency sleuthing, alarm triage, and making dashboards read like plain language folktales.",
  },
  {
    period: "Narrative incident tooling",
    title: "Incident tooling at scale",
    description:
      "Helped an energy marketplace untangle their incident response stack. Introduced narrative timelines, better on-call rotations, and rituals for post-incident repair that stuck — at least in this version of events.",
  },
  {
    period: "Platform stewardship",
    title: "Systems as scaffolding",
    description:
      "Built internal platforms for research teams — provisioning pipelines, handwritten docs, and a focus on letting scientists ship without asking permission. Some of the scientists were fictional, all of the lessons were real.",
  },
  {
    period: "Learning by maintaining",
    title: "Caretaking beginnings",
    description:
      "Freelance caretaker for civic tech projects, community radio automation, and the odd museum kiosk. I cut my teeth keeping other people's ideas alive and learned how to honor the ghosts in the machine.",
  },
];

const principles = [
  {
    title: "Maintenance as design",
    description:
      "Every feature I ship carries a maintenance plan: who tends it, how it fails, and how we gracefully sunset it when the season changes — even if the feature only exists in a story.",
  },
  {
    title: "Operational empathy",
    description:
      "I sit with dispatchers, field techs, and support teams to hear how the tools land. That proximity keeps the work honest, regardless of how embellished the narrative becomes.",
  },
  {
    title: "Document the weather",
    description:
      "Lightweight runbooks, annotated dashboards, and living changelogs give future-us the context we wish past-us had written down. The weather reports are timeless on purpose.",
  },
];

const signals = [
  {
    title: "Curiosities",
    notes: [
      "Bringing narrative structure into observability tools so humans can follow along without a pager.",
      "Exploring how music theory can inform systems thinking — cadence, modulation, and tension release in product work.",
    ],
  },
  {
    title: "Practices that stick",
    notes: [
      "Starting projects with shared glossaries and retiring jargon early.",
      "Treating docs, onboarding, and incident reviews as design artefacts, not leftovers.",
    ],
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <header class="absolute inset-x-0 top-0 z-20">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-6">
        <a href="/" class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-200 dark:text-slate-100">
          alexogeny.dev
        </a>
        <nav class="hidden gap-6 text-sm font-medium text-slate-200/90 backdrop-blur sm:flex">
          <a href="/" class="transition hover:text-white">Home</a>
          <a href="/#orientation" class="transition hover:text-white">Orientation</a>
          <a href="/blog" class="transition hover:text-white">Logbook</a>
          <a href="#contact" class="transition hover:text-white">Say hi</a>
        </nav>
      </div>
    </header>
  </Fragment>

  <section class="relative isolate overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100">
    <div class="absolute inset-0 -z-10 opacity-60">
      <div class="absolute left-1/2 top-16 h-72 w-72 -translate-x-1/2 rounded-full bg-emerald-400/30 blur-[120px]"></div>
      <div class="absolute right-12 top-40 h-48 w-48 rounded-full bg-sky-500/40 blur-3xl"></div>
      <div class="absolute bottom-0 left-8 h-32 w-32 rounded-full bg-purple-500/40 blur-3xl"></div>
    </div>
    <div class="mx-auto flex max-w-5xl flex-col gap-12 px-6 pb-24 pt-32 sm:pb-32 sm:pt-40">
      <p class="text-xs uppercase tracking-[0.45em] text-slate-300/80">Perennial signal — Field notes</p>
      <div class="space-y-8 sm:max-w-3xl">
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl">
          I'm Alex — a product-minded engineer who treats calm systems as collaborative fiction.
        </h1>
        <p class="text-lg leading-relaxed text-slate-300">
          This page collects the threads I'm pulling on: what I'm building, how I show up, and the habits that keep the work grounded.
          It's less a résumé and more a field notebook from a timeline that always feels a half-step away.
        </p>
      </div>
      <div class="rounded-3xl border border-slate-200/20 bg-white/5 p-8 backdrop-blur">
        <dl class="grid gap-6 sm:grid-cols-2">
          {orientation.map(({ label, value }) => (
            <div class="grid gap-3" key={label}>
              <dt class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">{label}</dt>
              <dd class="text-sm leading-relaxed text-slate-200">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200/60 bg-slate-50 py-20 text-slate-900 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto grid max-w-5xl gap-12 px-6 sm:grid-cols-[1.1fr_1fr] sm:items-start">
      <div class="space-y-6">
        <h2 class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-700 dark:text-slate-300">Why I build</h2>
        <p class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Software is infrastructure. The best kind disappears into the background and lets people do their real work.
        </p>
        <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">
          I'm usually the person translating between design, data, and the humans doing the on-call rotations. I ship tools, write
          the supporting playbooks, and keep an eye on how things age. The fictional framing is just a tool to explore the edges
          of that practice without pinning it to a single release date.
        </p>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-white/80 p-8 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/70">
        <h3 class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Signals</h3>
        <div class="mt-6 space-y-6">
          {signals.map(({ title, notes }) => (
            <div key={title} class="space-y-3">
              <h4 class="text-base font-semibold text-slate-900 dark:text-slate-100">{title}</h4>
              <ul class="space-y-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {notes.map((note) => (
                  <li key={note} class="flex gap-3">
                    <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-slate-400"></span>
                    <span>{note}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto flex max-w-5xl flex-col gap-12 px-6">
      <div class="space-y-4 sm:max-w-3xl">
        <h2 class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-700 dark:text-slate-300">Field timeline</h2>
        <p class="text-3xl font-semibold tracking-tight sm:text-4xl">
          A few waypoints that shaped how I practice.
        </p>
        <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">
          The through-line is maintenance: building things we can sustain, documenting as we go, and leaving room for the next
          people to extend the work. The settings might shift, but the craft stays familiar.
        </p>
      </div>
      <div class="space-y-8">
        {timeline.map(({ period, title, description }) => (
          <article
            class="group rounded-3xl border border-slate-200 bg-slate-50/80 p-6 transition hover:-translate-y-1 hover:border-slate-300 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-slate-700"
            key={period}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-3 text-sm font-medium uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">
              <span>{period}</span>
              <span class="tracking-normal text-xs text-slate-400 dark:text-slate-500">{title}</span>
            </div>
            <p class="mt-4 text-base leading-relaxed text-slate-700 dark:text-slate-200">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-100 py-20 text-slate-900 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto grid max-w-5xl gap-12 px-6 sm:grid-cols-[1fr_1.1fr] sm:items-start">
      <div class="space-y-6">
        <h2 class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-700 dark:text-slate-300">Principles</h2>
        <p class="text-3xl font-semibold tracking-tight sm:text-4xl">Practices I return to on every project.</p>
        <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">
          These are less commandments and more anchors — reminders to design for caretakers, to leave breadcrumbs, and to keep the
          humans visible in every dashboard, regardless of which version of events we're in.
        </p>
      </div>
      <div class="space-y-6">
        {principles.map(({ title, description }) => (
          <div
            class="rounded-3xl border border-slate-200 bg-white/80 p-6 shadow-sm backdrop-blur transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-slate-700"
            key={title}
          >
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="bg-white py-20 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto flex max-w-5xl flex-col gap-10 px-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="space-y-4 sm:max-w-xl">
        <h2 class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-700 dark:text-slate-300">Stay in touch</h2>
        <p class="text-3xl font-semibold tracking-tight sm:text-4xl">Have a project, story, or maintenance tale?</p>
        <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">
          I'm always up for comparing notes on tooling, trade-offs, or how to keep teams breathing. Write me a line and let's find a calm
          moment to chat — even if we're collaborating across imaginary distance.
        </p>
      </div>
      <div class="flex flex-col gap-4 sm:items-end">
        <a
          href="mailto:hello@alexogeny.dev"
          class="inline-flex items-center justify-center rounded-full border border-slate-900/10 bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-800 dark:border-slate-100/10 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200"
        >
          hello@alexogeny.dev
        </a>
        <a
          href="https://github.com/alexogeny"
          class="text-sm font-medium text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
        <a
          href="https://www.linkedin.com/in/alexmack"
          class="text-sm font-medium text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn ↗
        </a>
      </div>
    </div>
  </section>
</Layout>
