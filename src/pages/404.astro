---
import PanelLayout from '~/layouts/PanelLayout.astro';

const metadata = {
  title: '404 — Page Not Found',
  description: 'The page you are looking for does not exist.',
};
---

<PanelLayout metadata={metadata}>
  <div class="panel text-center">
    <p class="text-6xl font-semibold text-[var(--text-accent)] mb-4">404</p>
    <h1 class="text-xl font-medium mb-4">Off the trail</h1>
    <p class="text-sm text-[var(--text-muted)] mb-6">
      This page doesn't exist. Maybe it never did.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors"
    >
      <span>←</span>
      <span>Back to base camp</span>
    </a>
  </div>
</PanelLayout>
