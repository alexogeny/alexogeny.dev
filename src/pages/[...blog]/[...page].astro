---
import BlogList from "~/components/blog/List.astro";
import Pagination from "~/components/blog/Pagination.astro";
import Layout from "~/layouts/PageLayout.astro";

import { blogListRobots, getStaticPathsBlogList } from "~/utils/blog";

export const prerender = true;

export async function getStaticPaths({ paginate }) {
  return await getStaticPathsBlogList({ paginate });
}

const { page } = Astro.props;
const currentPage = page.currentPage ?? 1;
const isFirstPage = currentPage === 1;

const metadata = {
  title: `Logbook${currentPage > 1 ? ` — Page ${currentPage}` : ""}`,
  description:
    "A timeless archive of speculative field reports, maintenance myths, and imagined dispatches about keeping software kind.",
  robots: {
    index: blogListRobots?.index && isFirstPage,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: "blog",
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <header class="absolute inset-x-0 top-0 z-20">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-6">
        <a href="/" class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-200 dark:text-slate-100">
          alexogeny.dev
        </a>
        <nav class="hidden gap-6 text-sm font-medium text-slate-200/90 backdrop-blur sm:flex">
          <a href="/" class="transition hover:text-white">Home</a>
          <a href="/about" class="transition hover:text-white">About</a>
          <a href="#entries" class="transition hover:text-white">Entries</a>
          <a href="/contact" class="transition hover:text-white">Contact</a>
        </nav>
      </div>
    </header>
  </Fragment>

  <section class="relative isolate overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100">
    <div class="absolute inset-0 -z-10 opacity-60">
      <div class="absolute left-1/2 top-20 h-72 w-72 -translate-x-1/2 rounded-full bg-sky-500/35 blur-[120px]"></div>
      <div class="absolute right-10 top-36 h-48 w-48 rounded-full bg-emerald-400/30 blur-3xl"></div>
      <div class="absolute bottom-0 left-12 h-36 w-36 rounded-full bg-purple-500/40 blur-3xl"></div>
    </div>
    <div class="mx-auto flex max-w-5xl flex-col gap-12 px-6 pb-24 pt-32 sm:pb-32 sm:pt-40">
      <p class="text-xs uppercase tracking-[0.45em] text-slate-300/80">Ambient signal — The logbook</p>
      <div class="space-y-8 sm:max-w-3xl">
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl">Fragments from parallel projects.</h1>
        <p class="text-lg leading-relaxed text-slate-300">
          {isFirstPage
            ? "These entries are fictionalized dispatches, stitched from real instincts and imagined futures. Treat them like stage directions for kinder tooling, not a literal changelog."
            : "Keep wandering. The archive doubles back on itself, but every fragment carries a cue you can adapt to your own timeline."}
        </p>
      </div>
      <div class="rounded-3xl border border-slate-200/20 bg-white/5 p-6 backdrop-blur sm:max-w-2xl">
        <p class="text-sm leading-relaxed text-slate-200">
          Expect soft science fiction about operations, infrastructure, and care work. None of it is dated, all of it is true
          in spirit. Subscribe via RSS if you enjoy following maintenance myths in your own reader.
        </p>
      </div>
    </div>
  </section>

  <section id="entries" class="border-t border-slate-200 bg-slate-50 py-20 text-slate-900 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto flex max-w-5xl flex-col gap-12 px-6">
      <div class="space-y-4">
        <h2 class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-700 dark:text-slate-300">Collected entries</h2>
        <p class="text-3xl font-semibold tracking-tight sm:text-4xl">Stories, experiments, and maintenance myths.</p>
      </div>
      <BlogList posts={page.data} />
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </div>
  </section>
</Layout>
