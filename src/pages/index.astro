---
import PanelLayout from '~/layouts/PanelLayout.astro';

const metadata = {
  title: 'Alex Mack — alexogeny.dev',
  description: 'Software engineer, systems thinker, and quiet builder of thoughtful tools.',
};

const currentPath = '/';
---

<PanelLayout metadata={metadata}>
  <div class="panel">
    <header class="mb-6">
      <p class="text-xs uppercase tracking-[0.3em] text-[var(--text-accent)] mb-2">alexogeny.dev</p>
      <h1 class="text-2xl font-semibold tracking-tight">Alex Mack</h1>
    </header>

    <div class="space-y-4 text-sm leading-relaxed text-[var(--text-muted)]">
      <p>
        Software engineer based in Brisbane. I build systems that work quietly in the background
        — fleet operations tools, monitoring pipelines, and interfaces that feel familiar to the
        people who depend on them.
      </p>
      <p>
        When I'm not writing code, I'm tending personal infrastructure, archiving family memories,
        or thinking about how to keep software soft.
      </p>
    </div>

    <div class="mt-6 flex items-center gap-4">
      <a
        href="mailto:hello@alexogeny.dev"
        class="text-sm text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors"
      >
        hello@alexogeny.dev
      </a>
      <span class="text-[var(--text-accent)]">·</span>
      <a
        href="https://github.com/alexogeny"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors"
      >
        github
      </a>
    </div>

    <nav class="trail-nav">
      <a href="/" class="trail-link active">
        <span class="trail-marker"></span>
        Home
      </a>
      <a href="/cv" class="trail-link">
        <span class="trail-marker"></span>
        CV
      </a>
      <a href="/projects" class="trail-link">
        <span class="trail-marker"></span>
        Projects
      </a>
      <a href="/contact" class="trail-link">
        <span class="trail-marker"></span>
        Contact
      </a>
    </nav>
  </div>
</PanelLayout>
