---
import Layout from "~/layouts/PageLayout.astro";

const metadata = {
  title: "Alex Mack — alexogeny.dev",
  description:
    "A personal snapshot of what I'm tinkering with, listening to, and learning right now.",
};

const nowList = [
  {
    label: "Working on",
    value:
      "quiet tools for electric mobility teams — interface trim, data gardening, and keeping crews unblocked.",
  },
  { label: "Based in", value: "Brisbane, Yuggera & Turrbal Country" },
  {
    label: "Listening",
    value: "Cleo Sol's 'Nothing on Me' on loop while sketching UI states.",
  },
  {
    label: "Learning",
    value: "how to make slow, patient software that keeps humans in the room.",
  },
];

const glimpses = [
  {
    title: "Making infrastructure feel like a friend",
    description:
      "Guiding a small team through the messiness of EV fleet ops software — lots of operational empathy, ruthless pruning of alerts, and gentle automation where it helps real people sleep better.",
  },
  {
    title: "Caretaking old projects",
    description:
      "Keeping personal tools patched and breathable: a home server that hosts family archives, a weather station that texts when storms roll in, and a few tiny bots that remind friends to drink water.",
  },
  {
    title: "Writing when the light is right",
    description:
      "Drafting essays about maintenance, calm engineering teams, and the weird intersections of music theory and incident response.",
  },
];

const logbook = [
  {
    date: "July 2024",
    entry:
      "Rebuilt our telemetry ingestion to speak in stories instead of graphs — operators finally have a timeline they can annotate and trust.",
  },
  {
    date: "May 2024",
    entry:
      "Helped an energy startup untangle their deployment pipeline with a weekend of humane defaults and better docs.",
  },
  {
    date: "January 2024",
    entry:
      "Spent evenings digitising family Super 8 footage and teaching my niece how checksum workflows work.",
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <header class="absolute inset-x-0 top-0 z-20">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-6">
        <a href="#" class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-200 dark:text-slate-100">
          alexogeny.dev
        </a>
        <nav class="hidden gap-6 text-sm font-medium text-slate-200/90 backdrop-blur sm:flex">
          <a href="#now" class="transition hover:text-white">Now</a>
          <a href="#glimpses" class="transition hover:text-white">Glimpses</a>
          <a href="#logbook" class="transition hover:text-white">Logbook</a>
          <a href="/about" class="transition hover:text-white">About</a>
        </nav>
      </div>
    </header>
  </Fragment>

  <section class="relative isolate overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100">
    <div class="absolute inset-0 -z-10 opacity-60">
      <div class="absolute left-1/2 top-16 h-72 w-72 -translate-x-1/2 rounded-full bg-sky-500/40 blur-[120px]"></div>
      <div class="absolute right-12 top-48 h-40 w-40 rounded-full bg-purple-500/40 blur-3xl"></div>
      <div class="absolute bottom-0 left-12 h-32 w-32 rounded-full bg-emerald-400/30 blur-3xl"></div>
    </div>
    <div class="mx-auto flex max-w-5xl flex-col gap-16 px-6 pb-24 pt-32 sm:pb-32 sm:pt-40">
      <p class="text-xs uppercase tracking-[0.45em] text-slate-300/80">Moment in time · Updated July 2024</p>
      <div class="space-y-8 sm:max-w-3xl">
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl">
          Hello, I'm Alex — an engineer keeping the lights soft and the systems kind.
        </h1>
        <p class="text-lg leading-relaxed text-slate-300">
          This page is my little weather report. It's not a manifesto or a sales pitch — just a snapshot of what I'm tending to,
          what I'm paying attention to, and the experiments that are keeping me curious this season.
        </p>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <a
          href="mailto:hello@alexogeny.dev"
          class="inline-flex items-center justify-center rounded-full border border-slate-100/20 bg-slate-100/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:border-slate-100/40 hover:bg-slate-100/20"
        >
          Say hi
        </a>
        <a
          href="https://github.com/alexogeny"
          class="text-sm font-medium text-slate-300 transition hover:text-white"
          target="_blank"
          rel="noopener noreferrer"
        >
          Peek at the code garden ↗
        </a>
      </div>
    </div>
  </section>

  <section id="now" class="border-y border-slate-200/50 bg-slate-50 py-20 text-slate-900 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto grid max-w-5xl gap-12 px-6 sm:grid-cols-[1.2fr_1fr] sm:items-start">
      <div class="space-y-6">
        <h2 class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-700 dark:text-slate-300">Right now</h2>
        <p class="text-3xl font-semibold tracking-tight sm:text-4xl">
          I'm making space for thoughtful software, good documentation, and teams that take care of each other.
        </p>
        <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">
          Most of my days are spent pairing with operators, tending data models, and sketching interfaces that feel familiar to
          the people who depend on them. Nights are for music, archival rabbit holes, and a rotating roster of tinkering
          projects.
        </p>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-white/70 p-8 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/70">
        <dl class="space-y-6">
          {nowList.map(({ label, value }) => (
            <div class="grid gap-2" key={label}>
              <dt class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">{label}</dt>
              <dd class="text-base leading-relaxed text-slate-700 dark:text-slate-200">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section id="glimpses" class="bg-white py-20 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto flex max-w-5xl flex-col gap-12 px-6">
      <div class="space-y-4 sm:max-w-2xl">
        <h2 class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-700 dark:text-slate-300">Glimpses</h2>
        <p class="text-3xl font-semibold tracking-tight sm:text-4xl">Little projects and threads I'm following.</p>
        <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">
          These are the things occupying headspace lately. Some are paid work, some are for friends, some are just to see what
          happens when curiosity wins.
        </p>
      </div>
      <div class="grid gap-10 md:grid-cols-3">
        {glimpses.map(({ title, description }) => (
          <article
            class="group flex flex-col gap-4 rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-1 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
            key={title}
          >
            <h3 class="text-lg font-semibold text-slate-900 transition group-hover:text-sky-600 dark:text-slate-100 dark:group-hover:text-sky-400">
              {title}
            </h3>
            <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="logbook" class="border-t border-slate-200 bg-slate-100 py-20 text-slate-900 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto flex max-w-5xl flex-col gap-10 px-6">
      <div class="space-y-4 sm:max-w-2xl">
        <h2 class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-700 dark:text-slate-300">Logbook</h2>
        <p class="text-3xl font-semibold tracking-tight sm:text-4xl">Recent moments I'm keeping close.</p>
        <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">
          I'm not maintaining a traditional blog right now. Instead, I drop notes here when something shifts the way I think about
          work, tools, or community.
        </p>
      </div>
      <div class="space-y-6">
        {logbook.map(({ date, entry }) => (
          <div
            class="rounded-3xl border border-slate-200 bg-white/70 p-6 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/60"
            key={date}
          >
            <div class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">{date}</div>
            <p class="mt-3 text-base leading-relaxed text-slate-700 dark:text-slate-200">{entry}</p>
          </div>
        ))}
      </div>
      <div class="pt-4 text-sm text-slate-500 dark:text-slate-400">
        Want a longer read? There's an <a href="/about" class="underline decoration-slate-400 underline-offset-4 transition hover:text-slate-700 dark:hover:text-slate-200">about page</a>
        and an occasionally updated <a href="/blog" class="underline decoration-slate-400 underline-offset-4 transition hover:text-slate-700 dark:hover:text-slate-200">blog archive</a>.
      </div>
    </div>
  </section>
</Layout>
