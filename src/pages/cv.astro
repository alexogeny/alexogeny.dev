---
import PanelLayout from '~/layouts/PanelLayout.astro';

const metadata = {
  title: 'CV — Alex Mack',
  description: 'Career experience and technical skills.',
};

const experience = [
  {
    role: 'Senior Software Engineer',
    company: 'Fleet Operations',
    period: '2022 — Present',
    description: 'Building monitoring pipelines and operator interfaces for electric vehicle fleet management.',
  },
  {
    role: 'Software Engineer',
    company: 'Energy Startup',
    period: '2019 — 2022',
    description: 'Developed deploy rituals and documentation systems. Focused on humane defaults and team workflows.',
  },
  {
    role: 'Full Stack Developer',
    company: 'Consulting',
    period: '2016 — 2019',
    description: 'Client work across web applications, data pipelines, and internal tools.',
  },
];

const skills = [
  'Python', 'TypeScript', 'Go', 'Rust',
  'PostgreSQL', 'Redis', 'Kafka',
  'Kubernetes', 'Terraform', 'AWS',
];
---

<PanelLayout metadata={metadata}>
  <div class="panel">
    <header class="mb-6">
      <a href="/" class="text-xs uppercase tracking-[0.3em] text-[var(--text-accent)] hover:text-[var(--text-muted)] transition-colors mb-2 inline-block">
        ← alexogeny.dev
      </a>
      <h1 class="text-2xl font-semibold tracking-tight">Curriculum Vitae</h1>
    </header>

    <section class="mb-8">
      <h2 class="text-xs uppercase tracking-[0.2em] text-[var(--text-accent)] mb-4">Experience</h2>
      <div class="space-y-5">
        {experience.map((job) => (
          <div class="border-l border-[var(--panel-border)] pl-4">
            <div class="flex items-baseline justify-between gap-4 mb-1">
              <h3 class="text-sm font-medium">{job.role}</h3>
              <span class="text-xs text-[var(--text-accent)] whitespace-nowrap">{job.period}</span>
            </div>
            <p class="text-xs text-[var(--text-muted)] mb-1">{job.company}</p>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">{job.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-6">
      <h2 class="text-xs uppercase tracking-[0.2em] text-[var(--text-accent)] mb-4">Skills</h2>
      <div class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="text-xs px-2 py-1 rounded bg-[rgba(255,255,255,0.05)] text-[var(--text-muted)] border border-[var(--panel-border)]">
            {skill}
          </span>
        ))}
      </div>
    </section>

    <nav class="trail-nav">
      <a href="/" class="trail-link">
        <span class="trail-marker"></span>
        Home
      </a>
      <a href="/cv" class="trail-link active">
        <span class="trail-marker"></span>
        CV
      </a>
      <a href="/projects" class="trail-link">
        <span class="trail-marker"></span>
        Projects
      </a>
      <a href="/contact" class="trail-link">
        <span class="trail-marker"></span>
        Contact
      </a>
    </nav>
  </div>
</PanelLayout>
