---
import PanelLayout from '~/layouts/PanelLayout.astro';

const metadata = {
  title: 'Contact — Alex Mack',
  description: 'Get in touch.',
};

const links = [
  {
    label: 'Email',
    value: 'hello@alexogeny.dev',
    href: 'mailto:hello@alexogeny.dev',
  },
  {
    label: 'GitHub',
    value: 'github.com/alexogeny',
    href: 'https://github.com/alexogeny',
  },
  {
    label: 'X / Twitter',
    value: '@alexogeny',
    href: 'https://x.com/alexogeny',
  },
  {
    label: 'Discord',
    value: 'alexogeny',
    href: 'https://discord.com/users/305879281580638228',
  },
];
---

<PanelLayout metadata={metadata}>
  <div class="panel">
    <header class="mb-6">
      <a href="/" class="text-xs uppercase tracking-[0.3em] text-[var(--text-accent)] hover:text-[var(--text-muted)] transition-colors mb-2 inline-block">
        ← alexogeny.dev
      </a>
      <h1 class="text-2xl font-semibold tracking-tight">Contact</h1>
    </header>

    <p class="text-sm text-[var(--text-muted)] leading-relaxed mb-6">
      Happy to hear from you. Whether it's about work, open source, or just to say hi.
    </p>

    <div class="space-y-4">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="flex items-baseline justify-between border-l border-[var(--panel-border)] pl-4 py-1 hover:border-[var(--text-muted)] transition-colors group"
        >
          <span class="text-xs uppercase tracking-[0.15em] text-[var(--text-accent)]">{link.label}</span>
          <span class="text-sm text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-colors">{link.value}</span>
        </a>
      ))}
    </div>

    <nav class="trail-nav">
      <a href="/" class="trail-link">
        <span class="trail-marker"></span>
        Home
      </a>
      <a href="/cv" class="trail-link">
        <span class="trail-marker"></span>
        CV
      </a>
      <a href="/projects" class="trail-link">
        <span class="trail-marker"></span>
        Projects
      </a>
      <a href="/contact" class="trail-link active">
        <span class="trail-marker"></span>
        Contact
      </a>
    </nav>
  </div>
</PanelLayout>
