---
import '~/assets/styles/tailwind.css';
import '@fontsource-variable/inter';
import { ViewTransitions } from 'astro:transitions';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import Metadata from '~/components/common/Metadata.astro';
import Analytics from '~/components/common/Analytics.astro';
import TopoBackground from '~/components/TopoBackground.astro';

import { I18N } from '~/utils/config';
import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!DOCTYPE html>
<html lang={language} dir={textDirection}>
  <head>
    <CommonMeta />
    <Favicons />
    <Metadata {...metadata} />
    <Analytics />
    <ViewTransitions />
    <style is:inline is:global>
      :root {
        --aw-font-sans: 'Inter Variable', system-ui, sans-serif;
        --panel-bg: rgba(10, 10, 10, 0.85);
        --panel-border: rgba(40, 40, 40, 0.6);
        --text-primary: #e5e5e5;
        --text-muted: #888888;
        --text-accent: #555555;
        --slide-out: slide-out-to-left;
        --slide-in: slide-in-from-right;
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: #000;
        color: var(--text-primary);
        font-family: var(--aw-font-sans);
      }

      body {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .panel {
        background: var(--panel-bg);
        border: 1px solid var(--panel-border);
        border-radius: 1rem;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        max-width: 480px;
        width: 100%;
        padding: 2.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        view-transition-name: panel;
      }

      .trail-nav {
        display: flex;
        gap: 0.5rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--panel-border);
      }

      .trail-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-muted);
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid transparent;
      }

      .trail-link:hover {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.05);
        border-color: var(--panel-border);
      }

      .trail-link.active {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.08);
      }

      .trail-marker {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        opacity: 0.5;
      }

      .trail-link:hover .trail-marker,
      .trail-link.active .trail-marker {
        opacity: 1;
      }

      /* View Transition Animations - Sliding in different directions */
      @keyframes slide-out-to-left {
        from { transform: translateX(0); opacity: 1; }
        to { transform: translateX(-80px); opacity: 0; }
      }

      @keyframes slide-out-to-right {
        from { transform: translateX(0); opacity: 1; }
        to { transform: translateX(80px); opacity: 0; }
      }

      @keyframes slide-out-to-top {
        from { transform: translateY(0); opacity: 1; }
        to { transform: translateY(-80px); opacity: 0; }
      }

      @keyframes slide-out-to-bottom {
        from { transform: translateY(0); opacity: 1; }
        to { transform: translateY(80px); opacity: 0; }
      }

      @keyframes slide-in-from-left {
        from { transform: translateX(-80px); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }

      @keyframes slide-in-from-right {
        from { transform: translateX(80px); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }

      @keyframes slide-in-from-top {
        from { transform: translateY(-80px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }

      @keyframes slide-in-from-bottom {
        from { transform: translateY(80px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }

      /* Panel transitions */
      ::view-transition-old(panel) {
        animation: 0.25s ease-out both var(--slide-out);
      }

      ::view-transition-new(panel) {
        animation: 0.25s ease-out 0.05s both var(--slide-in);
      }

      /* Keep topo background persistent - no animation */
      #topo-bg {
        view-transition-name: topo;
      }

      ::view-transition-old(topo),
      ::view-transition-new(topo) {
        animation: none;
        mix-blend-mode: normal;
      }
    </style>
  </head>
  <body class="antialiased">
    <TopoBackground transition:persist />
    <slot />

    <script is:inline>
      (function() {
        var pages = ['/', '/cv', '/projects', '/contact'];

        function getIdx(path) {
          var p = path.replace(/\/$/, '') || '/';
          return pages.indexOf(p);
        }

        function setDirection(fromPath, toPath) {
          var fromIdx = getIdx(fromPath);
          var toIdx = getIdx(toPath);

          // Pick random direction with bias based on navigation
          var dirs = [
            ['slide-out-to-left', 'slide-in-from-right'],
            ['slide-out-to-right', 'slide-in-from-left'],
            ['slide-out-to-top', 'slide-in-from-bottom'],
            ['slide-out-to-bottom', 'slide-in-from-top']
          ];

          var pick;
          if (fromIdx !== -1 && toIdx !== -1) {
            var diff = toIdx - fromIdx;
            if (diff > 0) {
              // Forward: left/down
              pick = Math.random() > 0.5 ? dirs[0] : dirs[3];
            } else {
              // Back: right/up
              pick = Math.random() > 0.5 ? dirs[1] : dirs[2];
            }
          } else {
            pick = dirs[Math.floor(Math.random() * 4)];
          }

          document.documentElement.style.setProperty('--slide-out', pick[0]);
          document.documentElement.style.setProperty('--slide-in', pick[1]);
        }

        document.addEventListener('astro:before-preparation', function(e) {
          setDirection(window.location.pathname, new URL(e.to).pathname);
        });
      })();
    </script>
  </body>
</html>
